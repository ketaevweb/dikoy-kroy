# SQLite для локальной разработки (на serverless заказы уходят в Telegram)
DATABASE_URL=file:/absolute/path/to/db/custom.db

# Telegram-бот для приёма заказов, подписок и заявок на ресток
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Пароль админки (/admin)
ADMIN_PASSWORD=

# Номер счётчика Яндекс Метрики (цели: product_view, add_to_cart,
# begin_checkout, purchase_complete, email_signup, restock_signup).
# Пусто = счётчик не подключается.
NEXT_PUBLIC_YM_ID=
